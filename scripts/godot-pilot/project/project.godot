; Standalone experimental Godot pilot. No production Asterloom storage is read.
config_version=5

[application]
config/name="Asterloom · Signalwright"
config/icon="res://assets/brand/icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="Asterloom-Godot-Pilot"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=980
window/size/min_height=680
window/stretch/mode="disabled"

[rendering]
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.019,0.032,0.057,1)

[audio]
default_bus_layout=""
